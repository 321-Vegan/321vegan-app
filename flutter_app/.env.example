# Copy this file to .env and replace with your actual API key
# DO NOT commit .env file to version control !

# API Configuration
API_KEY=your_actual_api_key_here
API_BASE_URL=https://api.321vegan.fr

S3_STORAGE_URL=https://321vegan-objects.s3.sbg.io.cloud.ovh.net

# Beta tests only (never in a build for the stores): each Veganuary day
# opens as soon as the one before it is done, instead of the next day
# VEGANUARY_UNLOCK_RIGHT_AWAY=true
