# Copy this file to .env and replace with your actual API key
# DO NOT commit .env file to version control !

# API Configuration
API_KEY=your_actual_api_key_here
API_BASE_URL=https://api.321vegan.fr

# Public URL of the S3 bucket (same value as VITE_S3_STORAGE_URL in the
# backoffice), used to display the restaurant photos
S3_STORAGE_URL=https://321vegan-objects.s3.sbg.io.cloud.ovh.net
